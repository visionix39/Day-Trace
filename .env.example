# Copy this file to .env.local, fill it in, and restart `npm run dev`.
# Never commit .env.local. On Vercel, add the same variables under
# Project → Settings → Environment Variables.

# --- The free AI ------------------------------------------------------------
# A free Groq key: https://console.groq.com/keys (sign up, no card needed).
# Secret: only the server sees it.
GROQ_API_KEY=

# Optional. Must be a Groq model that supports strict JSON schema output.
GROQ_MODEL=openai/gpt-oss-120b

# --- Accounts (optional) ----------------------------------------------------
# From your Supabase project: Project Settings → API Keys / Data API.
# Both are safe to show in the browser (NEXT_PUBLIC_ means exactly that); what
# a visitor can do is limited by the rules in supabase/setup.sql.
# Leave them empty and DayTrace runs without accounts (one notebook per browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
