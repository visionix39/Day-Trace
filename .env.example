# Copy this file to .env.local and fill in the key. Never commit .env.local.
#
# A free Groq key: https://console.groq.com/keys (sign up, no card needed).
# On Vercel, add the same variable under Project → Settings → Environment Variables.
GROQ_API_KEY=

# Optional. Must be a Groq model that supports strict JSON schema output.
GROQ_MODEL=openai/gpt-oss-120b
