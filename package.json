{
  "name": "day-trace",
  "version": "0.1.0",
  "private": true,
  "description": "DayTrace - the AI that remembers your unfinished business. Paste a note, get commitments, deadlines and people out, and a gentle daily follow-up list.",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "predev": "node scripts/copy-wasm.mjs",
    "dev": "next dev --port 3200",
    "prebuild": "node scripts/copy-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check:seed": "node scripts/check-seed.mjs",
    "eval": "tsx scripts/eval.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "3.7.6",
    "lucide-react": "0.549.0",
    "next": "15.5.25",
    "openai": "7.23.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "sql.js": "1.13.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/sql.js": "1.4.11",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
